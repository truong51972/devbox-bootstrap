#!/usr/bin/env bash
# Devbox CLI and TUI launcher, installed via ~/.local/bin/devbox.
set -Eeuo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$script")/.." && pwd)"
venv="$root/.venv"
upstream='https://github.com/truong51972/devbox-bootstrap.git'

setup_runtime() {
    local python="$venv/bin/python" requirements="$root/tui/requirements.txt"

    local uv_binary=''
    if command -v uv >/dev/null 2>&1; then
        uv_binary="$(command -v uv)"
    elif [[ -x "$HOME/.local/bin/uv" ]]; then
        uv_binary="$HOME/.local/bin/uv"
    elif [[ -x "$HOME/.cargo/bin/uv" ]]; then
        uv_binary="$HOME/.cargo/bin/uv"
    fi

    if [[ -n "$uv_binary" ]]; then
        # uv can find Python or download a managed interpreter if absent.
        echo "[devbox] Using uv for the isolated TUI environment: $uv_binary"
        if [[ ! -x "$python" ]]; then
            if ! "$uv_binary" venv "$venv"; then
                echo '[devbox] Could not create the virtual environment using uv.' >&2
                return 1
            fi
        fi
        if [[ ! -x "$python" ]]; then
            echo "[devbox] uv did not create a usable interpreter: $python" >&2
            return 1
        fi
        "$uv_binary" pip install --python "$python" -r "$requirements"
        return $?
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo '[devbox] No uv or python3 available. Install uv (recommended), or Python 3 with venv support.' >&2
        return 1
    fi

    echo '[devbox] uv not found; using python3 + venv.'
    if [[ ! -x "$python" ]]; then
        if ! python3 -m venv "$venv"; then
            echo '[devbox] Python venv is unavailable. Install python3-venv, or install uv instead.' >&2
            return 1
        fi
    fi
    if [[ ! -x "$python" ]]; then
        echo "[devbox] Virtual environment is incomplete: $venv" >&2
        return 1
    fi
    if ! "$python" -m pip --version >/dev/null 2>&1; then
        echo '[devbox] pip is missing inside the virtual environment. Repair Python venv/ensurepip or install uv.' >&2
        return 1
    fi
    "$python" -m pip install --disable-pip-version-check --no-input \
        -r "$requirements"
}

update_code() {
    if [[ ! -d "$root/.git" ]]; then
        echo "Not a Git checkout: $root" >&2
        return 1
    fi
    local origin branch
    origin="$(git -C "$root" remote get-url origin)"
    case "$origin" in
        "$upstream"|https://github.com/truong51972/devbox-bootstrap|git@github.com:truong51972/devbox-bootstrap.git)
            ;;
        *)
            echo "Refusing to update from unexpected origin: $origin" >&2
            return 1 ;;
    esac
    branch="$(git -C "$root" symbolic-ref --quiet --short HEAD || true)"
    if [[ "$branch" != main ]]; then
        echo "Refusing to update a non-main checkout (current: $branch)." >&2
        return 1
    fi
    if [[ -n "$(git -C "$root" status --porcelain --untracked-files=no)" ]]; then
        echo 'Local tracked files have changed. Review them before updating.' >&2
        return 1
    fi
    # Only fast-forward: never reset local source or force overwrite user edits.
    git -C "$root" fetch --no-tags origin main
    git -C "$root" merge --ff-only FETCH_HEAD
    setup_runtime
    printf 'Devbox code is current: %s\n' "$(git -C "$root" rev-parse --short HEAD)"
    echo 'Restart the TUI to load updated Python code.'
}

case "${1:-}" in
    --help|-h)
        cat <<'HELP'
Usage: devbox [OPTION]
  (no args)        Launch interactive TUI
  --update         Pull latest Devbox source from GitHub (fast-forward only)
  --setup-runtime  Create/update isolated venv (uv first; Python fallback)
  --version        Show installed Devbox Git revision
  --doctor         Run read-only diagnostics via the Bash backend
  --preflight      Inspect host environment
  --upgrade ...    Upgrade installed tools (not Devbox source code)
  --only ...       Install the selected tools
  --help           Show this help
HELP
        ;;
    --version)
        git -C "$root" rev-parse --short HEAD ;;
    --update)
        update_code ;;
    --setup-runtime)
        setup_runtime ;;
    '')
        if [[ ! -t 0 || ! -t 1 ]]; then
            echo "The TUI requires an interactive terminal. Use 'devbox --doctor' or 'devbox --help'." >&2
            exit 1
        fi
        if [[ ! -x "$venv/bin/python" ]] || ! "$venv/bin/python" -c 'import prompt_toolkit' 2>/dev/null; then
            setup_runtime
        fi
        cd "$root"
        exec "$venv/bin/python" -m tui.app ;;
    --doctor|--preflight|--upgrade|--dry-run|--only|--kubectl-version)
        exec bash "$root/setup-ubuntu.sh" "$@" ;;
    *)
        echo "Unknown argument: $1 (try devbox --help)." >&2
        exit 2 ;;
esac
