#!/usr/bin/env bash
# Devbox CLI and TUI launcher, installed via ~/.local/bin/devbox.
set -Eeuo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$script")/.." && pwd)"
venv="$root/.venv"
export DEVBOX_INVOCATION_CWD="${DEVBOX_INVOCATION_CWD:-$PWD}"
upstream='https://github.com/truong51972/devbox-bootstrap.git'
# shellcheck source=utils/operation-lock.sh
source "$root/utils/operation-lock.sh"

install_runtime() {
    local python="$venv/bin/python" requirements="$root/tui/requirements.txt"

    local uv_binary=''
    if command -v uv >/dev/null 2>&1; then
        uv_binary="$(command -v uv)"
    elif [[ -x "$HOME/.local/bin/uv" ]]; then
        uv_binary="$HOME/.local/bin/uv"
    elif [[ -x "$HOME/.cargo/bin/uv" ]]; then
        uv_binary="$HOME/.cargo/bin/uv"
    fi

    if [[ -n "$uv_binary" ]]; then
        # uv can find Python or download a managed interpreter if absent.
        echo "[devbox] Using uv for the isolated TUI environment: $uv_binary"
        if [[ ! -x "$python" ]]; then
            if ! "$uv_binary" venv "$venv"; then
                echo '[devbox] Could not create the virtual environment using uv.' >&2
                return 1
            fi
        fi
        if [[ ! -x "$python" ]]; then
            echo "[devbox] uv did not create a usable interpreter: $python" >&2
            return 1
        fi
        timeout 300 "$uv_binary" pip install --python "$python" -r "$requirements"
        return $?
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo '[devbox] No uv or python3 available. Install uv (recommended), or Python 3 with venv support.' >&2
        return 1
    fi

    echo '[devbox] uv not found; using python3 + venv.'
    if [[ ! -x "$python" ]]; then
        if ! python3 -m venv "$venv"; then
            echo '[devbox] Python venv is unavailable. Install python3-venv, or install uv instead.' >&2
            return 1
        fi
    fi
    if [[ ! -x "$python" ]]; then
        echo "[devbox] Virtual environment is incomplete: $venv" >&2
        return 1
    fi
    if ! "$python" -m pip --version >/dev/null 2>&1; then
        echo '[devbox] pip is missing inside the virtual environment. Repair Python venv/ensurepip or install uv.' >&2
        return 1
    fi
    timeout 300 "$python" -m pip install --disable-pip-version-check --no-input \
        -r "$requirements"
}

runtime_fingerprint() {
    local digest
    digest="$(sha256sum "$root/tui/requirements.txt")" || return 1
    printf 'runtime-v1:%s\n' "${digest%% *}"
}

runtime_ready() {
    local expected
    expected="$(runtime_fingerprint)" || return 1
    [[ -x "$venv/bin/python" && -f "$venv/.devbox-runtime" &&
        "$(cat "$venv/.devbox-runtime")" == "$expected" ]] &&
        "$venv/bin/python" -c 'import prompt_toolkit' 2>/dev/null
}

setup_runtime() {
    devbox_acquire_lock || return 1
    if runtime_ready; then return 0; fi
    local expected stamp
    expected="$(runtime_fingerprint)" || return 1
    rm -f -- "$venv/.devbox-runtime"
    if ! install_runtime || ! "$venv/bin/python" -c 'import prompt_toolkit' ||
       [[ "$(runtime_fingerprint)" != "$expected" ]]; then
        echo 'Runtime setup incomplete. Run devbox --setup-runtime to retry.' >&2
        return 1
    fi
    stamp="$(mktemp "$venv/.devbox-runtime.XXXXXX")" || return 1
    if ! printf '%s\n' "$expected" > "$stamp" || ! mv -f -- "$stamp" "$venv/.devbox-runtime"; then
        rm -f -- "$stamp"
        return 1
    fi
}

update_code() {
    local expected="${1:-}"
    if [[ -n "$expected" && ! "$expected" =~ ^[0-9a-f]{40}$ ]]; then
        echo 'Invalid expected update revision.' >&2
        return 1
    fi
    devbox_acquire_lock || return 1

    if [[ ! -d "$root/.git" ]]; then
        echo "Not a Git checkout: $root" >&2
        return 1
    fi
    local origin branch target current
    origin="$(git -C "$root" remote get-url origin)"
    case "$origin" in
        "$upstream"|https://github.com/truong51972/devbox-bootstrap|git@github.com:truong51972/devbox-bootstrap.git)
            ;;
        *)
            echo "Refusing to update from unexpected origin: $origin" >&2
            return 1 ;;
    esac
    branch="$(git -C "$root" symbolic-ref --quiet --short HEAD || true)"
    if [[ "$branch" != main ]]; then
        echo "Refusing to update a non-main checkout (current: $branch)." >&2
        return 1
    fi
    if [[ -n "$(git -C "$root" status --porcelain --untracked-files=no)" ]]; then
        echo 'Local tracked files have changed. Review them before updating.' >&2
        return 1
    fi
    # Only fast-forward: never reset local source or force overwrite user edits.
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}" \
        timeout 60 git -C "$root" fetch --no-tags --no-recurse-submodules --no-write-fetch-head origin +refs/heads/main:refs/devbox/update
    target="$(git -C "$root" rev-parse refs/devbox/update)"
    current="$(git -C "$root" rev-parse HEAD)"
    if [[ -n "$expected" && "$target" != "$expected" ]]; then
        echo "Upstream changed after confirmation; reopen Devbox to review the new revision." >&2
        return 1
    fi
    if ! git -C "$root" merge-base --is-ancestor "$current" "$target"; then
        echo "Refusing update: local history is ahead or diverged." >&2
        return 1
    fi
    git -C "$root" merge --ff-only "$target"
    # Run the runtime bootstrap from the freshly updated launcher, rather than
    # reusing a function loaded from an older script before the Git update.
    if ! bash "$root/bin/devbox" --setup-runtime; then
        echo "Source updated, but runtime is not ready. Run devbox --setup-runtime to recover." >&2
        return 1
    fi
    printf 'Devbox code is current: %s\n' "$(git -C "$root" rev-parse --short HEAD)"
    echo 'Restart the TUI to load updated Python code.'
}

case "${1:-}" in
    --help|-h)
        cat <<'HELP'
Usage: devbox [OPTION]
  (no args)        Launch interactive TUI
  --update         Pull latest Devbox source from GitHub (fast-forward only)
  --setup-runtime  Create/update isolated venv (uv first; Python fallback)
  --version        Show installed Devbox Git revision
  --clean ...      Scan or explicitly clean developer caches (see --clean --help)
  --doctor         Run read-only diagnostics via the Bash backend
  --preflight      Inspect host environment
  --upgrade ...    Upgrade installed tools (not Devbox source code)
  --only ...       Install the selected tools
  actions          List convenience toolkit actions
  net/sys/docker/storage/agent/env/project/util/health/run  Toolkit subcommands
  --help           Show this help
HELP
        ;;
    --version)
        git -C "$root" rev-parse --short HEAD ;;
    --update)
        if (( $# > 2 )); then echo "Usage: devbox --update [expected-revision]" >&2; exit 2; fi
        update_code "${2:-}" ;;
    --setup-runtime)
        setup_runtime ;;
    '')
        if [[ ! -t 0 || ! -t 1 ]]; then
            echo "The TUI requires an interactive terminal. Use 'devbox --doctor' or 'devbox --help'." >&2
            exit 1
        fi
        if ! runtime_ready; then
            setup_runtime
        fi
        if [[ -n "${DEVBOX_LOCK_FD:-}" ]]; then
            fd="$DEVBOX_LOCK_FD"
            exec {fd}>&-
            unset DEVBOX_LOCK_FD
        fi
        cd "$root"
        exec "$venv/bin/python" -m tui.app ;;
    --clean)
        shift
        cd "$root"
        if [[ -x "$venv/bin/python" ]]; then
            exec "$venv/bin/python" -m tui.cleaner "$@"
        fi
        exec python3 -m tui.cleaner "$@" ;;
    actions|net|sys|docker|storage|agent|env|project|util|health|doctor|run)
        cd "$root"
        if [[ -x "$venv/bin/python" ]]; then
            exec "$venv/bin/python" -m tui.toolkit.cli "$@"
        fi
        exec python3 -m tui.toolkit.cli "$@" ;;
    --doctor|--preflight|--upgrade|--dry-run|--only|--kubectl-version)
        exec bash "$root/setup-ubuntu.sh" "$@" ;;
    *)
        echo "Unknown argument: $1 (try devbox --help)." >&2
        exit 2 ;;
esac
